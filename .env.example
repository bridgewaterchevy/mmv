# Postgres connection string. Leave unset for local dev: the server falls back to an embedded
# Postgres (pglite) stored in ./data/pglite. On Render use the Supabase "Transaction pooler" URI
# (port 6543, IPv4-compatible), e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Or, simpler: paste only the Supabase database password and the app assembles the URL
# (host/user/port default to the values in render.yaml when set there).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PORT=5432

# Supabase project URL (Project Settings -> API), e.g. https://<ref>.supabase.co. Leave unset to store photos on local disk (./uploads).
SUPABASE_URL=
# Supabase service_role key (server-side only; never ship to the client). Required together with SUPABASE_URL for Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Public Storage bucket for outfit photos; created on boot if missing. Default: outfits
SUPABASE_BUCKET=outfits

# Google AI Studio key for garment recognition. Without it uploads still work but analysisFailed=true.
GEMINI_API_KEY=
# Comma-separated list of Gemini models to try in order (optional).
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# HTTP port (Render sets this automatically). Default: 5000
PORT=5000

# ---- Shopping prices + affiliate links (all optional) ----
# SerpApi private key (https://serpapi.com/manage-api-key). Powers GET /api/picks/:id/prices via the
# Google Shopping engine. Free plan = 250 searches/month; results are cached 24h per search query.
SERPAPI_KEY=
# HasData key (https://app.hasdata.com) — optional fallback Google Shopping provider used when
# SERPAPI_KEY is missing or SerpApi fails (429 quota / errors). Sent as the x-api-key header.
HASDATA_API_KEY=
# Max provider calls per UTC day across both providers (default 8 ≈ 240/month, keeps the free quota alive).
# When spent, the API serves cached offers (even stale) or an empty list and never calls a provider.
PRICE_LOOKUPS_PER_DAY=8
# Sovrn Commerce (ex-VigLink) site API key. When set, every non-Amazon retailer link is wrapped as
# https://redirect.viglink.com?key=<key>&u=<encoded url>  (https://developer.sovrn.com/reference/building-monetized-urls)
SOVRN_API_KEY=
# Amazon Associates tracking id, e.g. yourstore-20. Added as ?tag= on amazon.* links.
# Amazon prices are never shown (policy requires PA-API); the UI shows "See price on Amazon".
AMAZON_ASSOCIATES_TAG=
